{{- $desired := .packages.vscode.common -}}
{{- if eq .profile.name "personal" -}}
{{-   $desired = concat $desired .packages.vscode.personal -}}
{{- end -}}
{{- if and (ne .profile.type "synology-nas") (gt (len $desired) 0) -}}
#!/usr/bin/env bash
set -euo pipefail

# Re-run automatically once VS Code is installed if it wasn't present on first apply
# code binary: {{ or (lookPath "code") (and (eq .chezmoi.os "darwin") (stat "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code") "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code") }}
CODE_BIN="$(command -v code 2>/dev/null || true)"
if [[ -z "$CODE_BIN" && -x "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" ]]; then
  CODE_BIN="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
fi
if [[ -z "$CODE_BIN" ]]; then
  exit 0
fi

desired=(
{{- range $desired }}
  {{ . | quote }}
{{- end }}
)

{{- if eq .profile.name "work" }}
if command -v yq >/dev/null 2>&1 && [[ -d "$HOME/.local/share/dotfiles-work/.chezmoidata" ]]; then
  for f in "$HOME/.local/share/dotfiles-work/.chezmoidata/"*.yaml "$HOME/.local/share/dotfiles-work/.chezmoidata/"*.yml; do
    [[ -f "$f" ]] || continue
    while IFS= read -r ext; do
      [[ -n "$ext" ]] && desired+=("$ext")
    done < <(yq -r '.packages.vscode // {} | .[][]?' "$f" 2>/dev/null || true)
  done
fi
{{- end }}

desired_lc="$(printf '%s\n' "${desired[@]}" | tr '[:upper:]' '[:lower:]')"
installed="$(NODE_NO_WARNINGS=1 "$CODE_BIN" --list-extensions 2>/dev/null | tr -d '\r' | tr '[:upper:]' '[:lower:]' || true)"

failed=""
for ext in "${desired[@]}"; do
  ext_lc="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"
  if ! grep -Fxq "$ext_lc" <<< "$installed"; then
    echo "==> Installing VS Code extension: $ext"
    if ! out="$(NODE_NO_WARNINGS=1 "$CODE_BIN" --install-extension "$ext" --force 2>&1)"; then
      echo "==> Warning: failed to install VS Code extension: $ext" >&2
      [[ -n "$out" ]] && printf '%s\n' "$out" >&2
      failed="${failed:+$failed }$ext"
    fi
  fi
done

while IFS= read -r inst; do
  [[ -z "$inst" ]] && continue
  inst_lc="$(printf '%s' "$inst" | tr '[:upper:]' '[:lower:]')"
  if ! grep -Fxq "$inst_lc" <<< "$desired_lc"; then
    echo "==> Uninstalling unlisted VS Code extension: $inst"
    if ! out="$(NODE_NO_WARNINGS=1 "$CODE_BIN" --uninstall-extension "$inst" 2>&1)"; then
      echo "==> Warning: could not uninstall VS Code extension: $inst (may be required by another extension)" >&2
      [[ -n "$out" ]] && printf '%s\n' "$out" >&2
    fi
  fi
done <<< "$(NODE_NO_WARNINGS=1 "$CODE_BIN" --list-extensions 2>/dev/null | tr -d '\r' || true)"

if [[ -n "$failed" ]]; then
  echo "==> Some VS Code extensions failed to install ($failed). Re-run 'dots apply' when online." >&2
  exit 1
fi
{{- end }}
