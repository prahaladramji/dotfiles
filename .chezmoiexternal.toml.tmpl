[".local/share/oh-my-zsh"]
  type = "archive"
  url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
  exact = true
  stripComponents = 1
[".config/oh-my-zsh/plugins/zsh-autosuggestions"]
  type = "archive"
  url = "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
  exact = true
  stripComponents = 1
[".config/oh-my-zsh/plugins/zsh-syntax-highlighting"]
  type = "archive"
  url = "https://github.com/zsh-users/zsh-syntax-highlighting/archive/master.tar.gz"
  exact = true
  stripComponents = 1
{{- if eq .profile.type "synology-nas" }}
[".local"]
  type = "archive"
  url = "https://github.com/neovim/neovim-releases/releases/latest/download/nvim-linux-x86_64.tar.gz"
  stripComponents = 1
[".local/bin/dnscontrol"]
  type = "archive-file"
  url = {{ gitHubLatestReleaseAssetURL "DNSControl/dnscontrol" "dnscontrol_*_linux_amd64.tar.gz" | quote }}
  path = "dnscontrol"
  executable = true
[".local/bin/lego"]
  type = "archive-file"
  url = {{ gitHubLatestReleaseAssetURL "go-acme/lego" "lego_*_linux_amd64.tar.gz" | quote }}
  path = "lego"
  executable = true
[".local/bin/restic"]
  type = "file"
  url = {{ gitHubLatestReleaseAssetURL "restic/restic" "restic_*_linux_amd64.bz2" | quote }}
  decompress = "bzip2"
  executable = true
[".local/bin/tofu"]
  type = "archive-file"
  url = {{ gitHubLatestReleaseAssetURL "opentofu/opentofu" "tofu_*_linux_amd64.tar.gz" | quote }}
  path = "tofu"
  executable = true
{{- else if ne .profile.type "virtual" }}
[".nvm"]
  type = "archive"
  url = "https://github.com/nvm-sh/nvm/archive/master.tar.gz"
  stripComponents = 1
{{- end }}
{{- if and (eq .chezmoi.os "linux") (ne .profile.type "synology-nas") }}
[".local/share/fonts/hack"]
  type = "archive"
  url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v{{ .versions.nerd_fonts }}/Hack.zip"
  exact = true
  include = ["HackNerdFont*.ttf"]
{{- end }}
