ZSH_CUSTOM="$HOME/.config/oh-my-zsh"
ZSH_THEME=""

zstyle ':omz:update' mode disabled
typeset -U path cdpath fpath manpath

{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
fpath+=(/opt/homebrew/share/zsh/site-functions)
{{- if eq .profile.name "personal" }}
path=(/opt/homebrew/opt/coreutils/libexec/gnubin $path)
manpath=(/opt/homebrew/opt/coreutils/libexec/gnuman $manpath)
{{- end }}
{{- end }}
{{- if eq .profile.type "synology-nas" }}
export LANG="en_US.utf8"
export LC_ALL="en_US.utf8"
export CGO_ENABLED=0
path=($HOME/.local/bin $HOME/.local/share/go/bin $HOME/go/bin /usr/local/bin /usr/local/sbin /usr/syno/bin /usr/syno/sbin $path)
{{- else }}
path=($HOME/.local/bin $HOME/go/bin $path)
{{- end }}

plugins=(
{{- if ne .profile.type "synology-nas" }}
  direnv
{{- end }}
  fzf
  git
  history
  history-substring-search
  timer
  zsh-autosuggestions
  zsh-syntax-highlighting
{{- if not (has .profile.type (list "virtual" "synology-nas")) }}
  nvm
{{- end }}
)

HIST_STAMPS="yyyy-mm-dd"

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[comment]=fg=8,bold

TIMER_FORMAT="[%d]"
TIMER_PRECISION="2"

export EDITOR="nvim"
export GPG_TTY=$TTY

{{- if not (has .profile.type (list "virtual" "synology-nas")) }}
zstyle ':omz:plugins:nvm' lazy yes
zstyle ':omz:plugins:nvm' autoload yes
{{- end }}

source $ZSH/oh-my-zsh.sh

HISTSIZE=999999999
SAVEHIST=999999999

# Aliases
alias vi="nvim"
alias vim="nvim"
alias ls="ls -AFhl --color=auto"
alias sshkill='pkill -f "ssh(uttle -D| -|:)"'

{{- if eq .profile.type "synology-nas" }}
alias hl="homelab"
{{- end }}

# Source drop-in configs (e.g., 00-dots.zsh and work overlay configs)
for conf in "$HOME/.config/zsh/conf.d/"*.zsh(N); do
  source "$conf"
done
