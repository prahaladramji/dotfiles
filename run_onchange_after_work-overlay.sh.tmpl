#!/usr/bin/env bash
set -euo pipefail

# Clean up legacy files previously tracked in chezmoi and stale Zsh/portal artifacts
rm -f "$HOME/.config/oh-my-zsh/fix-paste.zsh" \
      "$HOME/.config/oh-my-zsh/manjaro-zsh-config.zsh" \
      "$HOME/.config/oh-my-zsh/tmux-session.zsh" \
      "$HOME/.config/rofi/tokyonight.rasi" \
      "$HOME/.config/i3/i3status.conf"
rm -rf "$HOME/.config/oh-my-zsh/themes" \
       "$HOME/.oh-my-zsh" \
       "$HOME/.tmux.conf" \
       "$HOME/.zsh" \
       "$HOME/.zcompdump"* \
       "$HOME/.zcompdumps" \
       "$HOME/.config/xdg-desktop-wlr"

# Lock down chezmoi source & config directories (no group/world read/write/exec)
chmod -R go-rwx "$HOME/.local/share/chezmoi"
if [[ -d "$HOME/.config/chezmoi" ]]; then
  chmod -R go-rwx "$HOME/.config/chezmoi"
fi
if [[ -d "$HOME/.config" ]]; then
  chmod -R go-w "$HOME/.config"
fi

{{- if eq .profile.type "synology-nas" }}
GO_VERSION="$(curl -fsSL https://go.dev/VERSION?m=text | head -n 1 | tr -d '[:space:]')"
CURRENT_GO="$("$HOME/.local/share/go/bin/go" version 2>/dev/null | awk '{print $3}' || true)"
if [[ -n "$GO_VERSION" && ( "$CURRENT_GO" != "$GO_VERSION" || ! -d "$HOME/.local/share/go/src/runtime" ) ]]; then
  echo "Installing $GO_VERSION to ~/.local/share/go..."
  rm -rf "$HOME/.local/share/go"
  mkdir -p "$HOME/.local/share"
  curl -fsSL "https://go.dev/dl/${GO_VERSION}.linux-amd64.tar.gz" | tar -C "$HOME/.local/share" -xzf -
fi
{{- end }}

{{- if eq .profile.name "work" }}
WORK_DIR="$HOME/.local/share/dotfiles-work"
WORK_STATE="$HOME/.config/chezmoi/chezmoistate-work.boltdb"

if [[ -d "$WORK_DIR" ]]; then
  chmod -R go-rwx "$WORK_DIR"
  chezmoi -S "$WORK_DIR" --persistent-state "$WORK_STATE" apply --no-tty
fi
{{- end }}
